pipeline {
    agent any
    environment {
        STAGING_NAMESPACE = 'kijani-staging'
        PROD_NAMESPACE    = 'default'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Tools Setup') {
            steps {
                sh '''
                    if ! command -v kubectl >/dev/null 2>&1; then
                        echo "kubectl not found — installing to workspace..."
                        curl -sLO "https://dl.k8s.io/release/$(curl -sL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mkdir -p bin
                        mv kubectl bin/
                    fi
                '''
            }
        }
        stage('Deploy to Staging') {            steps {
                sh '''
                    export PATH="$WORKSPACE/bin:$PATH"
                    kubectl apply -k k8s/staging
                    kubectl rollout status deployment/kk-payments -n ${STAGING_NAMESPACE} --timeout=120s
                '''
            }
        }
        stage('Smoke Test — Staging') {            steps {
                script {
                    sh '''
                        export PATH="$WORKSPACE/bin:$PATH"
                        kubectl port-forward -n ${STAGING_NAMESPACE} svc/kk-payments 8081:80 &
                        PF_PID=$!
                        sleep 5
                        STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8081/healthz || echo "000")
                        kill $PF_PID || true
                        if [ "$STATUS" != "200" ]; then
                            echo "Smoke test FAILED — staging healthz returned $STATUS"
                            exit 1
                        fi
                        echo "Smoke test PASSED — staging healthz returned 200"
                    '''
                }
            }
        }
        stage('Approval Gate — Production') {            steps {
                script {
                    def approver = input(
                        message: 'Smoke test passed. Approve production deployment?',
                        submitterParameter: 'APPROVER',
                        parameters: [
                            text(name: 'APPROVAL_REASON', defaultValue: '', description: 'Why is this being approved for production?')
                        ]
                    )
                    echo "Approved by: ${approver}"
                }
            }
        }
        stage('Deploy to Production') {            steps {
                sh '''
                    export PATH="$WORKSPACE/bin:$PATH"
                    kubectl apply -k k8s/production
                    kubectl rollout status deployment/kk-payments -n ${PROD_NAMESPACE} --timeout=120s
                '''
            }
        }
    }
    post {
        failure {
            echo 'Pipeline failed — production gate was never reached, or a stage errored.'
        }
        success {
            echo 'Pipeline completed. Check the approval log above for who approved and why.'
        }
    }
}
